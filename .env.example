# SPDX-License-Identifier: Apache-2.0
# nullpii — local env. Copy to .env and fill secrets. .env is gitignored.

# ─── RunPod (used by packages/eval/scripts/runpod/*) ─────────────
# Get key at https://runpod.io/console/user/settings (API Keys section).
# Used by launch.sh / resume.sh to spin up GPU pods via GraphQL API.
RUNPOD_API_KEY=

# Pod naming/preferences (optional — defaults work)
RUNPOD_POD_NAME="nullpii-bench-5090"
RUNPOD_GPU_TYPE_ID="NVIDIA GeForce RTX 5090"
RUNPOD_VOLUME_GB=75
RUNPOD_CONTAINER_GB=40
# Blackwell (5090) requires CUDA 12.8 wheels — pick the matching image.
RUNPOD_IMAGE="runpod/pytorch:2.8.0-py3.11-cuda12.8.1-cudnn-devel-ubuntu22.04"
# SECURE = on-demand (no preemption); COMMUNITY = cheaper but spot.
RUNPOD_CLOUD_TYPE=SECURE

# SSH key id registered on RunPod (Settings → SSH Public Keys → "id" column)
# leave blank to use the first key on the account.
RUNPOD_SSH_KEY_ID=

# ─── HuggingFace (model downloads on pod) ─────────────────────────
HUGGING_FACE_HUB_TOKEN=
