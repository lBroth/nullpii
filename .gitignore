packages/eval/results/

# bench scripts + tests — internal, not yet public release
packages/eval/scripts/
packages/eval/tests/

# sub-package lockfiles leak the dev's private registry URLs
# (popgrinder CodeArtifact); root lockfile is the single source of truth
packages/*/package-lock.json

.claude/
THIRD_PARTY_LICENSES.csv
