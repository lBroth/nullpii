# SPDX-License-Identifier: Apache-2.0
# Project-local registry override. Pins all installs in this repo to the
# public npm registry, regardless of what `~/.npmrc` is configured for
# (some devs have a private mirror like AWS CodeArtifact set there).
# Without this, `package-lock.json` ends up with resolved URLs from the
# private mirror — which leaks the dev's org and breaks installs on any
# machine without that mirror configured.
registry=https://registry.npmjs.org/

# Don't fall back to user-level config for the registry key.
@anthropic-ai:registry=https://registry.npmjs.org/
@nullpii:registry=https://registry.npmjs.org/
@lbroth:registry=https://registry.npmjs.org/
