# SPDX-License-Identifier: Apache-2.0
# Project-local registry override. Pins all installs in this repo to the
# public npm registry, whatever registry a developer's `~/.npmrc` names.
# Without it, `package-lock.json` can record resolved URLs from a private
# mirror, which names that mirror and breaks installs on any machine
# without it.
registry=https://registry.npmjs.org/

# Don't fall back to user-level config for the registry key.
@anthropic-ai:registry=https://registry.npmjs.org/
@lbroth:registry=https://registry.npmjs.org/
