{
  "name": "nullpii",
  "version": "0.0.7",
  "description": "Sanitize PII from LLM prompts locally. Reversible vault. Zero cloud calls. Multi-backend (CPU/MPS/CUDA/ROCm/WebGPU).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nullpii": "./bin/nullpii.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./backend/cpu": {
      "types": "./dist/backend/cpu-backend.d.ts",
      "import": "./dist/backend/cpu-backend.js"
    },
    "./backend/mps": {
      "types": "./dist/backend/mps-backend.d.ts",
      "import": "./dist/backend/mps-backend.js"
    },
    "./backend/cuda": {
      "types": "./dist/backend/cuda-backend.d.ts",
      "import": "./dist/backend/cuda-backend.js"
    },
    "./backend/rocm": {
      "types": "./dist/backend/rocm-backend.d.ts",
      "import": "./dist/backend/rocm-backend.js"
    },
    "./middleware/anthropic": {
      "types": "./dist/middleware/anthropic.d.ts",
      "import": "./dist/middleware/anthropic.js"
    }
  },
  "files": ["dist", "src", "README.md", "LICENSE", "NOTICE", "bin"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "license-check": "license-checker --production --excludePrivatePackages --onlyAllow 'MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;CC0-1.0;Apache 2.0;BlueOak-1.0.0;Unlicense;0BSD'",
    "circular-check": "madge --circular --extensions ts src/",
    "prepare": "lefthook install || true",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "size-check": "node scripts/size-check.mjs"
  },
  "dependencies": {
    "@anush008/tokenizers": "^0.6.0",
    "chalk": "^5.6.2",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.3",
    "debug": "^4.4.3"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "onnxruntime-node": "^1.20.0"
  },
  "peerDependenciesMeta": {
    "onnxruntime-node": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@biomejs/biome": "^1.9.4",
    "@types/cli-progress": "^3.11.6",
    "@types/debug": "^4.1.13",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^2.1.8",
    "fast-check": "^4.7.0",
    "lefthook": "^1.10.0",
    "license-checker": "^25.0.1",
    "madge": "^8.0.0",
    "onnxruntime-node": "^1.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lBroth/nullpii.git"
  },
  "bugs": {
    "url": "https://github.com/lBroth/nullpii/issues"
  },
  "homepage": "https://github.com/lBroth/nullpii#readme",
  "author": "nullpii contributors",
  "keywords": [
    "pii",
    "redaction",
    "anonymization",
    "sanitize",
    "llm",
    "claude",
    "openai",
    "privacy",
    "onnx",
    "local"
  ]
}
