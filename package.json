{
  "name": "nullpii",
  "version": "0.5.2",
  "description": "Mask PII and secrets in text locally, with a reversible in-memory vault. Detection runs on your machine (GLiNER ONNX on CPU, CUDA or CoreML via onnxruntime).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nullpii": "bin/nullpii.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md", "LICENSE", "NOTICE", "bin", "assets/logo.png"],
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run clean && npm run build && npm run typecheck && npm run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "NULLPII_E2E=1 vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "license-check": "license-checker --production --excludePrivatePackages --onlyAllow \"MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;CC0-1.0;Apache 2.0\" && node scripts/check-runtime-licences.mjs",
    "sbom": "cyclonedx-npm --output-format JSON --output-file bom.json",
    "circular-check": "madge --circular --extensions ts src/",
    "hygiene": "node scripts/check-repo-hygiene.mjs --all",
    "gateway:dev": "npm --prefix packages/gateway run dev",
    "prepare": "lefthook install || true",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "any-ascii": "^0.3.3",
    "chalk": "^5.6.2",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.3",
    "debug": "^4.4.3",
    "tokenizers": "^0.23.2"
  },
  "peerDependencies": {
    "onnxruntime-node": "^1.30.0"
  },
  "peerDependenciesMeta": {
    "onnxruntime-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@types/cli-progress": "^3.11.6",
    "@types/debug": "^4.1.13",
    "@types/node": "^22.19.17",
    "@vitest/coverage-v8": "4.1.12",
    "fast-check": "^4.7.0",
    "fastify": "5.12.6",
    "lefthook": "^1.10.0",
    "license-checker": "^25.0.1",
    "madge": "^8.0.0",
    "onnxruntime-node": "1.30.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "8.3.3",
    "vitepress": "1.6.4",
    "vitest": "4.1.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lBroth/nullpii.git"
  },
  "bugs": {
    "url": "https://github.com/lBroth/nullpii/issues"
  },
  "homepage": "https://lbroth.github.io/nullpii/",
  "author": "nullpii contributors",
  "keywords": ["pii", "redaction", "pseudonymization", "sanitize", "privacy", "onnx", "local"],
  "overrides": {
    "fast-uri": "3.1.8",
    "find-my-way": "9.9.0"
  }
}
