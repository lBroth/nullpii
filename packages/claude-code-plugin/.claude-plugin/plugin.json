{
  "name": "nullpii",
  "version": "0.0.12",
  "description": "Manage the local nullpii daemon + HTTP proxy. Sanitizes Anthropic API requests via ANTHROPIC_BASE_URL=http://localhost:7330.",
  "author": {
    "name": "nullpii",
    "url": "https://github.com/lBroth/nullpii"
  },
  "homepage": "https://github.com/lBroth/nullpii",
  "license": "Apache-2.0",
  "keywords": ["pii", "privacy", "redaction", "local", "onnx"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs\"",
            "timeout": 60,
            "statusMessage": "nullpii: loading PII model (first run downloads ~3 GB)…"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/stop.mjs\"",
            "timeout": 5,
            "statusMessage": "nullpii: unloading model…"
          }
        ]
      }
    ]
  }
}
