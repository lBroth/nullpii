{
  "name": "nullpii",
  "version": "0.0.8",
  "description": "Manage the local nullpii daemon (load/unload the PII model). Sanitization itself happens in your application code via the SDK middleware (`withNullPii(client)`).",
  "author": {
    "name": "nullpii",
    "url": "https://github.com/lBroth/nullpii"
  },
  "homepage": "https://github.com/lBroth/nullpii",
  "license": "Apache-2.0",
  "keywords": ["pii", "privacy", "redaction", "local", "onnx"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs\"",
            "timeout": 60,
            "statusMessage": "nullpii: loading PII model (first run downloads ~3 GB)…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/stop.mjs\"",
            "timeout": 5,
            "statusMessage": "nullpii: unloading model…"
          }
        ]
      }
    ]
  }
}
