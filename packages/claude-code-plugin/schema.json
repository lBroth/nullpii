{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://lbroth.github.io/nullpii/claude-code-plugin/schema.json",
  "title": "nullpii — Claude Code plugin settings",
  "description": "Schema for the `nullpii` block in `.claude/settings.json`.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "backend": {
      "type": "string",
      "enum": ["cpu", "mps", "cuda", "rocm", "auto"],
      "default": "auto",
      "description": "Hardware backend. `auto` picks CUDA → MPS → ROCm → CPU."
    },
    "variant": {
      "type": "string",
      "enum": ["fp32", "fp16", "int8", "int4", "int4f16", "auto"],
      "default": "auto",
      "description": "ONNX model variant. `auto` resolves per-backend."
    },
    "modelDir": {
      "type": "string",
      "description": "Override the local model cache directory."
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "revision"],
      "properties": {
        "repo": { "type": "string", "description": "HuggingFace org/repo." },
        "revision": { "type": "string", "description": "Pinned commit SHA." }
      }
    },
    "threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0,
      "description": "Drop spans below this confidence."
    },
    "strictLength": {
      "type": "boolean",
      "default": false,
      "description": "Throw `TextTooLongError` if encoded input exceeds maxSequenceLength."
    },
    "skip": {
      "type": "array",
      "items": { "type": "string", "format": "regex" },
      "description": "Skip sanitization for prompts whose first line matches any of these regexes (e.g. `^/git\\b`)."
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "account_number",
          "private_address",
          "private_date",
          "private_email",
          "private_person",
          "private_phone",
          "private_url",
          "secret"
        ]
      },
      "description": "Opt-in subset of PII categories. Default: all 8."
    }
  }
}
