{
  "name": "@lbroth/nullpii-gateway",
  "version": "0.5.2",
  "description": "Self-hosted HTTP gateway for the Anthropic Messages and OpenAI Chat Completions APIs: masks PII and secrets before the request leaves your machine and restores them in the response. Base-URL drop-in.",
  "license": "Apache-2.0",
  "keywords": [
    "pii",
    "sanitize",
    "redact",
    "anthropic",
    "claude",
    "claude-code",
    "gateway",
    "proxy",
    "llm-proxy",
    "anthropic-proxy",
    "privacy",
    "local-pii",
    "self-hosted",
    "openai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lBroth/nullpii.git",
    "directory": "packages/gateway"
  },
  "bugs": {
    "url": "https://github.com/lBroth/nullpii/issues"
  },
  "homepage": "https://lbroth.github.io/nullpii/guide/gateway",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nullpii-gateway": "bin/nullpii-gateway.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "bin", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --clear-screen=false --tsconfig tsconfig.dev.json src/dev.ts",
    "start": "node bin/nullpii-gateway.mjs",
    "prepublishOnly": "rm -rf dist && mkdir -p node_modules/nullpii && cp -R ../../dist ../../package.json ../../README.md ../../LICENSE ../../NOTICE node_modules/nullpii/ && tsc -p tsconfig.json"
  },
  "dependencies": {
    "fastify": "^5.12.5"
  },
  "peerDependencies": {
    "nullpii": ">=0.5.2-0 <0.6.0",
    "onnxruntime-node": "^1.30.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/",
    "@lbroth:registry": "https://registry.npmjs.org/"
  }
}
