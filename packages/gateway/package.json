{
  "name": "@nullpii/gateway",
  "version": "0.0.3",
  "description": "Self-hosted HTTP gateway that sanitizes PII before forwarding to Anthropic Claude, restores in the response. baseURL drop-in.",
  "license": "Apache-2.0",
  "keywords": [
    "pii",
    "sanitize",
    "redact",
    "anthropic",
    "claude",
    "claude-code",
    "gateway",
    "proxy",
    "llm-proxy",
    "anthropic-proxy",
    "gdpr",
    "hipaa",
    "privacy",
    "local-pii",
    "self-hosted"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lBroth/nullpii.git",
    "directory": "packages/gateway"
  },
  "bugs": {
    "url": "https://github.com/lBroth/nullpii/issues"
  },
  "homepage": "https://github.com/lBroth/nullpii/tree/main/packages/gateway#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nullpii-gateway": "./bin/nullpii-gateway.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "bin", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --clear-screen=false --tsconfig tsconfig.dev.json src/dev.ts",
    "start": "node bin/nullpii-gateway.mjs",
    "prepublishOnly": "rm -rf dist && npm run build"
  },
  "dependencies": {
    "fastify": "^5.2.0"
  },
  "peerDependencies": {
    "nullpii": ">=0.3.0 <0.4.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
